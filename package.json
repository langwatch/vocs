    "build:create-vocs": "rimraf create-vocs/_lib && tsc -p create-vocs/tsconfig.build.json"
  },
  "bin": {
    "vocs": "./src/_lib/cli/index.js"
  },
  "main": "./src/_lib/index.js",
  "exports": {
    ".": "./src/_lib/index.js",
    "./components": "./src/_lib/components.js",
    "./mdx-react": "./src/_lib/mdx-react.js"
  },
